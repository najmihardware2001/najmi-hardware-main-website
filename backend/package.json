{
  "name": "reusable-ecommerce-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend-independent Express and PostgreSQL commerce backend",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.cjs",
    "migrate:status": "node scripts/migrate.cjs --status",
    "create-admin": "node scripts/create-admin.cjs",
    "seed:demo": "node scripts/seed-demo.cjs",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "test:security": "node --test tests/security.test.cjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cloudinary": "2.11.0",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "8.23.0",
    "sharp": "0.35.5",
    "slugify": "1.6.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "supertest": "7.3.0"
  }
}
